; Reference schema; not independently validated or an interoperability result.
; Deterministic CBOR profile from wire.py; complete encoded page <= 8192 bytes.
; No COSE wrapper: authenticity is checked only after complete prefix hashing
; against a separately supplied authenticated receiver checkpoint.
archive-page = {
  "profile": "mixed-retention-archive-v2",
  "context_hash": bstr .size 32,
  "checkpoint_hash": bstr .size 32,
  "first": 1..18446744073709551615,
  "base_root": bstr .size 32,
  "facts": [1*16 (bstr .size (1..8192))]
}
; Each facts element must decode as a valid canonical retention-v2 fact from
; retention_v2.cddl, for exact consecutive route/epoch-derived sequence IDs.
; checkpoint_hash = SHA256(CBOR(["retention-archive-checkpoint",2,request,ack])).
; A verifier starts at first=1/base_root=genesis and never returns a selected
; fact until every prefix item through checkpoint.floor is present and the
; resulting root equals the receiver's authenticated checkpoint root.
