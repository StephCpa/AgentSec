; Reference schema, not independently CDDL-validated. Deterministic CBOR
; metadata only. Frame: WRP1 || uint32be(metadata length) || uint32be(body length)
; || metadata || raw body. Metadata <=8192 bytes; body <=16777216 bytes.
; Request has exactly one closed map; response metadata is tagged COSE_Sign1.
; Cross-field digest, identity, authorization and sequence rules are in
; witness_transport_contract.json and enforced by the Python adapter.

request = head-request / bootstrap-request / cas-request
common = (
  "profile": "witness-rpc-v1",
  "service": "agent-ledger-witness-v1",
  "namespace": namespace,
  "challenge": bstr .size 32,
  "body_size": 0..16777216,
  "body_hash": bstr .size 32
)
head-request = { common, "method": "head", "include_image": 0 / 1 }
bootstrap-request = { common, "method": "bootstrap" }
cas-request = {
  common,
  "method": "cas",
  "expected_seq": 0..4611686018427387903,
  "expected_digest": digest,
  "request_id": tstr .regexp "[0-9a-f]{32}"
}
namespace = tstr .regexp "[0-9a-f]{32}"
digest = tstr .regexp "[0-9a-f]{64}"

response = #6.18([
  protected: bstr .cbor {1: -19, 4: bstr},
  unprotected: {},
  payload: bstr .cbor reply,
  signature: bstr .size 64
])
reply-common = (
  "profile": "witness-rpc-v1",
  "service": "agent-ledger-witness-v1",
  "method": "head" / "bootstrap" / "cas",
  "namespace": namespace,
  "challenge": bstr .size 32,
  "request_digest": bstr .size 32,
  "requester": bstr .size 32,
  "body_size": 0..16777216,
  "body_hash": bstr .size 32
)
reply = success / rejection
success = {
  reply-common,
  "status": "ok",
  "result": {"seq": 0..4611686018427387904, "digest": digest}
}
rejection = {
  reply-common,
  "status": "rejected",
  "result": {"error": error-code}
}
error-code = "WITNESS_ACCESS_DENIED" / "WITNESS_UNINITIALIZED" /
  "WITNESS_ALREADY_INITIALIZED" / "WITNESS_CAS_CONFLICT" /
  "WITNESS_REQUEST_CONFLICT" / "INVALID_WITNESS_IMAGE" /
  "INVALID_WITNESS_VERSION" / "INVALID_WITNESS_REQUEST_ID"
